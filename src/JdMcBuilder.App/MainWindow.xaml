<Window x:Class="JdMcBuilder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC Campus Builder" Height="760" Width="1180" MinHeight="620" MinWidth="900">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="MC Campus Builder" />
            <TextBlock Foreground="Gray" Text="Leaf 1.21.11 / Paper-compatible · MCP direct mode · no Claude runtime" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,14,0,10" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="MCP Endpoint" />
                <TextBox x:Name="EndpointBox" Grid.Column="1" Margin="10,0,12,0" Text="http://127.0.0.1:33333/mcp" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="连接并发现工具" Click="ConnectButton_Click" />
                <Button Grid.Column="3" Content="导入蓝图" Click="ImportButton_Click" />
                <Button Grid.Column="4" Content="Dry Run" Click="DryRunButton_Click" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="状态与能力" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="ConnectionStatus" Text="未连接" FontWeight="SemiBold" />
                        <TextBlock x:Name="EnvironmentStatus" Margin="0,8,0,0" Text="目标环境：Leaf 1.21.11 / Paper Java" />
                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="工具发现" />
                        <ListBox x:Name="ToolsList" DisplayMemberPath="Name" Height="190" />
                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="后端能力" />
                        <TextBlock x:Name="BackendCapabilityStatus" Text="WorldEdit：未探测&#x0a;/fill：未探测&#x0a;/setblock：未探测" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,2" Text="探针方块（测试世界权限）" />
                        <TextBox x:Name="ProbeBlockBox" Text="minecraft:stone" />
                        <TextBlock Margin="0,8,0,2" Text="WorldEdit 范围：x,y,z;x,y,z" />
                        <TextBox x:Name="WorldEditProbeBox" />
                        <TextBlock Margin="0,8,0,2" Text="/fill 范围：x,y,z;x,y,z" />
                        <TextBox x:Name="NativeFillProbeBox" />
                        <TextBlock Margin="0,8,0,2" Text="/setblock 位置：x,y,z" />
                        <TextBox x:Name="SetBlockProbeBox" />
                        <Button Margin="0,10,0,0" Content="在指定探针坐标执行能力验证" Click="ProbeButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="蓝图预览与施工">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="BlueprintPath" Text="尚未导入蓝图" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" x:Name="BlueprintSummary" Margin="0,8,0,10" Text="导入 mc-blueprint/v1 JSON 或 JSONL 文件后显示统计。" TextWrapping="Wrap" />
                    <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="开始施工（需确认）" Click="StartBuildButton_Click" />
                        <Button Content="暂停" Click="PauseButton_Click" />
                        <Button Content="继续" Click="ResumeButton_Click" />
                        <Button Content="取消施工" Click="CancelButton_Click" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem><TextBlock x:Name="FooterStatus" Text="就绪：首次施工请使用测试世界" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
